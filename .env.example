# Copy to .env.local and fill in.

# Claude — required for the Session Engine, Content Mine, Ask and Pattern briefs.
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-5-5.
# ANTHROPIC_MODEL=claude-opus-5-5

# Supabase — optional. Without these, data lives in .data/stryn.json.
# Use the service-role key (server-side only; never expose it to the browser).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Password gate for the whole console. Leave empty for local-only use; set it before deploying.
OPERATOR_PASSWORD=

# Currency for revenue figures.
# NEXT_PUBLIC_CURRENCY=USD
